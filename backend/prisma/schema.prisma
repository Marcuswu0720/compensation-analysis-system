// 企业考勤管理系统 - Prisma Schema
// 范围：单地区（尼日利亚），暂不做 regionId 隔离；后续多地区扩展时可在关键表补充 regionId 字段。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 2. 角色与权限
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE // 员工
  LOCAL_MANAGER // 本地小管理者
  LOCAL_HR // 本地 HR / HRIS 团队
  HQ // 总部（只读）
  QC_TEAM // 质检团队：核查定位打卡异常记录（问题反馈 2.2），不涉及日常审批
}

// ---------------------------------------------------------------------------
// 组织架构：部门（树形）、办公室、用户
// ---------------------------------------------------------------------------

model Department {
  id        String       @id @default(uuid())
  name      String
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  leaderId  String?
  leader    User?        @relation("DeptLeader", fields: [leaderId], references: [id])
  users     User[]       @relation("UserDepartment")
  teams     Team[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Office {
  id                  String   @id @default(uuid())
  name                String
  address             String?
  gpsLat              Float?
  gpsLng              Float?
  allowedRadiusMeters Int      @default(300) // 打卡地理围栏允许半径（米），用于团队关联办公室后的范围校验（问题反馈 1.1）
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  officeStaff          User[]                        @relation("UserOffice")
  specialEventOffice   SpecialEventOffice[]
  matchedAttendance    AttendanceRecord[]
  officeAttendanceRule OfficeAttendanceRule[]        @relation("OfficeRuleOffices")
  ruleTemplates        TeamAttendanceRuleTemplate[]  @relation("RuleTemplateOffices")
}

// 团队/岗位（挂在部门下，作为打卡模式配置、规则模板的最小单元）
model Team {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leaderId     String?
  leader       User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members              User[]                      @relation("UserTeam")
  modeConfig           TeamAttendanceModeConfig?
  ruleTemplate         TeamAttendanceRuleTemplate?
  officeAttendanceRule OfficeAttendanceRule?
  shifts               Shift[]
}

model User {
  id           String      @id @default(uuid())
  employeeNo   String      @unique
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(EMPLOYEE)
  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  teamId       String?
  team         Team?       @relation("UserTeam", fields: [teamId], references: [id])
  managerId    String?
  manager      User?       @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[]      @relation("UserManager")
  position     String?
  officeId     String?
  office       Office?     @relation("UserOffice", fields: [officeId], references: [id])
  hireDate     DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  leadingDepartments Department[] @relation("DeptLeader")
  leadingTeams       Team[]       @relation("TeamLeader")

  refreshTokens        RefreshToken[]
  attendanceRecords    AttendanceRecord[]       @relation("AttendanceUser")
  scheduleAssignments  ScheduleAssignment[]     @relation("ScheduleUser")
  locationPhotos       LocationCheckInPhoto[]   @relation("LocationPhotoUser")
  verifiedPhotos       LocationCheckInPhoto[]   @relation("LocationPhotoVerifier")
  leaveApplications    LeaveApplication[]       @relation("LeaveUser")
  approvedLeaves       LeaveApplication[]       @relation("LeaveApprover")
  overtimeApplications OvertimeApplication[]    @relation("OvertimeUser")
  approvedOvertimes    OvertimeApplication[]    @relation("OvertimeApprover")
  auditLogs            AuditLog[]
  createdEvents        SpecialAttendanceEvent[] @relation("EventCreatedBy")
  revokedEvents        SpecialAttendanceEvent[] @relation("EventRevokedBy")

  locationAnomalies         LocationCheckinAnomaly[] @relation("AnomalyUser")
  reviewedLocationAnomalies LocationCheckinAnomaly[] @relation("AnomalyReviewer")
  notifications             Notification[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 3. 打卡模式总览：团队/岗位 -> 打卡模式映射
// ---------------------------------------------------------------------------

enum AttendanceMode {
  OFFICE // 模式1：办公室打卡
  SHIFT // 模式2：排班打卡
  LOCATION // 模式3：定位打卡
  HOME_OFFICE // 模式4：居家办公打卡（问题反馈 3.1，复用办公室打卡的时间判定逻辑，仅去掉地理位置/IP校验）
}

model TeamAttendanceModeConfig {
  id        String         @id @default(uuid())
  teamId    String         @unique
  team      Team           @relation(fields: [teamId], references: [id])
  mode      AttendanceMode
  updatedBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// 4. 模式1：办公室打卡 + 特殊事件全勤标记
// ---------------------------------------------------------------------------

// 10.3 考勤规则配置：办公室打卡的上下班时间、迟到/早退宽限时间（本地HR维护，按团队配置）
model OfficeAttendanceRule {
  id                String   @id @default(uuid())
  teamId            String   @unique
  team              Team     @relation(fields: [teamId], references: [id])
  startTime         String // HH:mm
  endTime           String // HH:mm
  lateGraceMinutes  Int      @default(0)
  earlyGraceMinutes Int      @default(0)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 团队关联的办公室（问题反馈 1.1）：打卡时的地理围栏范围以此为准；未关联任何办公室时不做范围校验（沿用原行为）
  offices Office[] @relation("OfficeRuleOffices")
}

enum AttendanceStatus {
  NORMAL // 正常
  LATE // 迟到
  EARLY_LEAVE // 早退
  ABSENT // 缺勤
  LEAVE // 请假
  FULL_ATTENDANCE // 全勤（特殊事件/请假等自动标记）
  PENDING // 定位打卡待核实
  UNCONFIGURED // 员工未配置团队或团队未配置考勤规则，无法判定，需HR尽快配置
}

enum AttendanceSource {
  OFFICE_CLOCK
  SHIFT_CLOCK
  LOCATION_CLOCK
  HOME_OFFICE_CLOCK
  SPECIAL_EVENT_AUTO
  LEAVE_AUTO
  MANUAL
}

// 每人每天一条汇总记录，clockIn/clockOut 为实际打卡时间
model AttendanceRecord {
  id                   String                  @id @default(uuid())
  userId               String
  user                 User                    @relation("AttendanceUser", fields: [userId], references: [id])
  date                 DateTime                @db.Date
  clockInAt            DateTime?
  clockOutAt           DateTime?
  status               AttendanceStatus        @default(PENDING)
  source               AttendanceSource
  lateMinutes          Int                     @default(0)
  earlyMinutes         Int                     @default(0)
  clockInLat           Float?
  clockInLng           Float?
  matchedOfficeId      String?
  matchedOffice        Office?                 @relation(fields: [matchedOfficeId], references: [id])
  remark               String?
  specialEventId       String?
  specialEvent         SpecialAttendanceEvent? @relation(fields: [specialEventId], references: [id])
  scheduleAssignmentId String?
  scheduleAssignment   ScheduleAssignment?     @relation(fields: [scheduleAssignmentId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

enum SpecialEventType {
  EXTREME_WEATHER // 极端天气
  EMERGENCY_EVENT // 突发事件
}

model SpecialAttendanceEvent {
  id              String               @id @default(uuid())
  type            SpecialEventType
  affectedOffices SpecialEventOffice[]
  startTime       DateTime
  endTime         DateTime
  createdById     String
  createdBy       User                 @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  revokedById     String?
  revokedBy       User?                @relation("EventRevokedBy", fields: [revokedById], references: [id])
  revokedAt       DateTime?
  remark          String?

  attendanceRecords AttendanceRecord[]
}

// 事件 <-> 办公室 多对多关联表（affectedOfficeIds）
model SpecialEventOffice {
  id       String                 @id @default(uuid())
  eventId  String
  event    SpecialAttendanceEvent @relation(fields: [eventId], references: [id])
  officeId String
  office   Office                 @relation(fields: [officeId], references: [id])

  @@unique([eventId, officeId])
}

// ---------------------------------------------------------------------------
// 5. 模式2：排班打卡 + 排班变更留痕
// ---------------------------------------------------------------------------

model Shift {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String // 如"早班"、"晚班"
  nameEn    String? // 英文名称，用于语言切换时显示
  startTime String // HH:mm
  endTime   String // HH:mm
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ScheduleAssignment[]

  @@index([teamId])
}

model ScheduleAssignment {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation("ScheduleUser", fields: [userId], references: [id])
  shiftId       String
  shift         Shift                @relation(fields: [shiftId], references: [id])
  date          DateTime             @db.Date
  isTemporary   Boolean              @default(false)
  changedFromId String? // 若为调整，指向被替换的历史排班记录
  changedFrom   ScheduleAssignment?  @relation("ScheduleChangeHistory", fields: [changedFromId], references: [id])
  changedTo     ScheduleAssignment[] @relation("ScheduleChangeHistory")
  changedBy     String?
  changedAt     DateTime?
  createdAt     DateTime             @default(now())

  attendanceRecords AttendanceRecord[]

  @@index([userId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// 6/7. 模式3：定位打卡 + 团队细分规则模板
// ---------------------------------------------------------------------------

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

model LocationCheckInPhoto {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation("LocationPhotoUser", fields: [userId], references: [id])
  photoUrl            String // 供前端展示的访问路径（/api/location-checkin/:id/photo）
  photoData           Bytes // 图片二进制内容，存数据库而非本地磁盘，避免云端免费实例磁盘不持久导致照片丢失
  photoMimeType       String       @default("image/jpeg")
  gpsLat              Float
  gpsLng              Float
  takenAt             DateTime
  verifiedById        String?
  verifiedBy          User?        @relation("LocationPhotoVerifier", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  verifyStatus        VerifyStatus @default(PENDING)
  monthlySummaryId    String?
  businessMetricValue Int? // 如码牌团队当日部署商户数
  isWithinRange       Boolean? // 是否在团队关联的有效打卡范围内；团队未配置 FIXED 范围时为 null（不适用，问题反馈 2.5）
  createdAt           DateTime     @default(now())

  anomaly LocationCheckinAnomaly? @relation("AnomalyPhoto")

  @@index([userId, takenAt])
}

// 定位打卡间隔超阈值的异常记录，交由质检团队核查（问题反馈 2.2）
model LocationCheckinAnomaly {
  id               String                @id @default(uuid())
  photoId          String                @unique
  photo            LocationCheckInPhoto  @relation("AnomalyPhoto", fields: [photoId], references: [id])
  userId           String
  user             User                  @relation("AnomalyUser", fields: [userId], references: [id])
  intervalMinutes  Int
  thresholdMinutes Int
  status           AnomalyReviewStatus   @default(PENDING)
  reviewNote       String?
  reviewedById     String?
  reviewedBy       User?                 @relation("AnomalyReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime              @default(now())

  @@index([status])
  @@index([userId])
}

enum AnomalyReviewStatus {
  PENDING // 待核查
  REVIEWED // 已核查
}

// 通用站内通知（问题反馈 2.2/2.4：定位打卡异常需通知质检团队/总部/码牌团队本人及上级）
model Notification {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  type              String // 如 LOCATION_ANOMALY / LOCATION_ANOMALY_PRE_WARNING
  title             String // 服务端兜底文案（中文），前端按 type+params 走 i18n 渲染，title/message 仅作未知类型时的兜底
  message           String
  params            Json? // 供前端 i18n 插值用的结构化数据，如 { name, intervalMinutes, thresholdMinutes }
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId, isRead])
}

model TeamAttendanceRuleTemplate {
  id                            String               @id @default(uuid())
  teamId                        String               @unique
  team                          Team                 @relation(fields: [teamId], references: [id])
  requiresClockIn               Boolean              @default(true)
  requiresClockOut              Boolean              @default(true)
  requiresPhoto                 Boolean              @default(false)
  photoIntervalThresholdMinutes Int?
  photoIntervalPreWarnMinutes   Int? // 间隔快超时前提前提醒的分钟数，如 10（问题反馈 2.4.2）
  requiresBusinessMetric        Boolean              @default(false)
  businessMetricThreshold       Int?
  businessMetricSource          String? // 待确认：API对接 or 人工录入
  officeAssignmentMode          OfficeAssignmentMode @default(NONE)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt

  // officeAssignmentMode = FIXED 时，拍照打卡会校验 GPS 是否落在这些关联地点的允许半径内（问题反馈 2.5）
  offices Office[] @relation("RuleTemplateOffices")
}

enum OfficeAssignmentMode {
  NEAREST_AUTO
  FIXED
  NONE
}

// ---------------------------------------------------------------------------
// 8. 请假 / 加班申请与审批
// ---------------------------------------------------------------------------

// 请假类型可配置（10.3节），初始通过 seed 预置 事假/病假/年假/婚假/产假
model LeaveTypeConfig {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  nameEn   String? // 英文名称，用于语言切换时显示
  isActive Boolean @default(true)

  leaveApplications LeaveApplication[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveApplication {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation("LeaveUser", fields: [userId], references: [id])
  typeId         String
  type           LeaveTypeConfig @relation(fields: [typeId], references: [id])
  startTime      DateTime
  endTime        DateTime
  reason         String
  attachmentUrl  String?
  status         ApprovalStatus  @default(PENDING)
  approverId     String?
  approver       User?           @relation("LeaveApprover", fields: [approverId], references: [id])
  approveComment String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model OvertimeApplication {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation("OvertimeUser", fields: [userId], references: [id])
  date           DateTime       @db.Date
  hours          Float
  reason         String
  status         ApprovalStatus @default(PENDING)
  approverId     String?
  approver       User?          @relation("OvertimeApprover", fields: [approverId], references: [id])
  approveComment String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 10. 法定节假日
// ---------------------------------------------------------------------------

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  isWorkday Boolean  @default(false) // true = 调休上班日

  @@unique([date])
}

// ---------------------------------------------------------------------------
// 11. 统一审计日志
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REVOKE
  VERIFY
  APPROVE
  REJECT
  CANCEL
}

model AuditLog {
  id         String      @id @default(uuid())
  entityType String // SCHEDULE / SPECIAL_EVENT / LOCATION_CHECKIN / RULE_CONFIG ...
  entityId   String
  action     AuditAction
  operatorId String
  operator   User        @relation(fields: [operatorId], references: [id])
  operatedAt DateTime    @default(now())
  detail     Json?

  @@index([entityType, entityId])
  @@index([operatorId])
}
